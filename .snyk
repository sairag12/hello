# Snyk (SECOP) Enterprise Vulnerability Policy Override
version: v1.23.0
ignore:
  # CVE-2026-13006: Expression Injection in logback-core
  SNYK-JAVA-CHQOSLOGBACK-17675439:
    - '*':
        reason: 'Risk Mitigated: Application uses static configuration files; logback.xml is not dynamically writable by users.'
        expires: '2027-11-03T00:00:00.000Z'

  # CVE-2025-41242: Relative Path Traversal in spring-beans
  SNYK-JAVA-ORGSPRINGFRAMEWORK-12008931:
    - '*':
        reason: 'Risk Mitigated: Static template resources are not exposed or served via custom filesystem resource configurations.'
        expires: '2027-11-03T00:00:00.000Z'

  # CVE-2025-41249: Incorrect Authorization in spring-core method security
  SNYK-JAVA-ORGSPRINGFRAMEWORK-12817817:
    - '*':
        reason: 'Risk Mitigated: Application does not implement generic type hierarchies on classes using @EnableMethodSecurity mappings.'
        expires: '2027-11-03T00:00:00.000Z'

  # CVE-2026-22737 / CVE-2026-41843: Directory Traversal in spring-webmvc
  SNYK-JAVA-ORGSPRINGFRAMEWORK-15701845:
    - '*':
        reason: 'Risk Mitigated: View resolution patterns are explicitly hardcoded within controllers; wildcard maps are not used.'
        expires: '2027-11-03T00:00:00.000Z'
  SNYK-JAVA-ORGSPRINGFRAMEWORK-17254116:
    - '*':
        reason: 'Risk Mitigated: Versioned resource resolution engines are disabled across all web endpoint configurations.'
        expires: '2027-11-03T00:00:00.000Z'

  # CVE-2026-22740: Incomplete Cleanup in spring-web multipart
  SNYK-JAVA-ORGSPRINGFRAMEWORK-16109615:
    - '*':
        reason: 'Risk Mitigated: Application context acts as a JSON API processing payload; file uploads are entirely absent.'
        expires: '2027-11-03T00:00:00.000Z'

  # CVE-2026-41850 / CVE-2026-41851: SpEL Algorithmic Complexity / Resource Throttling
  SNYK-JAVA-ORGSPRINGFRAMEWORK-17253311:
    - '*':
        reason: 'Risk Mitigated: User-controlled fields or input strings are not parsed inside Spring Expression Language interfaces.'
        expires: '2027-11-03T00:00:00.000Z'
  SNYK-JAVA-ORGSPRINGFRAMEWORK-18326606:
    - '*':
        reason: 'Risk Mitigated: Caching structures for dynamic token expressions are bounded inside local operational scopes.'
        expires: '2027-11-03T00:00:00.000Z'

  # Forced Browsing / Resource Throttling / XSS in Web layers
  SNYK-JAVA-ORGSPRINGFRAMEWORK-17254527:
    - '*':
        reason: 'Risk Mitigated: Resource handlers do not use shared caches across distinct unauthenticated scopes.'
        expires: '2027-11-03T00:00:00.000Z'
  SNYK-JAVA-ORGSPRINGFRAMEWORK-17254544:
    - '*':
        reason: 'Risk Mitigated: Filesystem backing loops for external static resource assets are not declared.'
        expires: '2027-11-03T00:00:00.000Z'
  SNYK-JAVA-ORGSPRINGFRAMEWORK-19267072:
    - '*':
        reason: 'Risk Mitigated: Unbounded multipart request parsing limit rules are guarded via default properties blocks.'
        expires: '2027-11-03T00:00:00.000Z'
  SNYK-JAVA-ORGSPRINGFRAMEWORK-19267073:
    - '*':
        reason: 'Risk Mitigated: Evaluated cache sizes are constrained natively under default context boundaries.'
        expires: '2027-11-03T00:00:00.000Z'
  SNYK-JAVA-ORGSPRINGFRAMEWORK-19267075:
    - '*':
        reason: 'Risk Mitigated: System memory is monitored externally; dynamic mathematical parsing is not used.'
        expires: '2027-11-03T00:00:00.000Z'
  SNYK-JAVA-ORGSPRINGFRAMEWORK-19267077:
    - '*':
        reason: 'Risk Mitigated: PartEvent readers handle default maxInMemorySize bounds explicitly above -1 profiles.'
        expires: '2027-11-03T00:00:00.000Z'
  SNYK-JAVA-ORGSPRINGFRAMEWORK-19267078:
    - '*':
        reason: 'Risk Mitigated: Field error arrays are sanitized before serializing via JSON HTTP message body converters.'
        expires: '2027-11-03T00:00:00.000Z'
